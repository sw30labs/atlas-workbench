# Copy to .env and adjust, or export these in your shell.
# Never commit real keys. `.env` is git-ignored.

# ── Where the data lives ─────────────────────────────────────────────
# One directory for every runtime store (default: ~/.atlas).
# ATLAS_HOME=~/.atlas

# ── Local model endpoint (optional) ──────────────────────────────────
# Without a model the workbench still runs: intake, review, deterministic
# scoring, exports, and the dashboard all work offline.
# ATLAS_LLM_PROVIDER=omlx            # omlx (Mac MLX) or dgx (NVIDIA vLLM)
# OMLX_BASE_URL=http://127.0.0.1:8000/v1
# OMLX_API_KEY=test
# OMLX_MODEL=DeepSeek-V4.1-Flash-1017-oQ4e-mtp
# OMLX_MODEL_JUDGE=DeepSeek-V4.1-Flash-1017-oQ4e-mtp

# NVIDIA DGX / vLLM instead of OMLX:
# ATLAS_LLM_PROVIDER=dgx
# DGX_BASE_URL=http://127.0.0.1:8000/v1
# DGX_API_KEY=test
# DGX_MODEL=Qwen/Qwen3.6-27B-FP8
# DGX_MODEL_JUDGE=Qwen/Qwen3.6-27B-FP8

# ── Safety switches (leave off unless you mean it) ───────────────────
# ATLAS_AUTO_RETIRE=1        # let maintenance merge/retire scenarios
# ATLAS_GUARD=off            # disable the fail-closed ontology write guard
# ATLAS_DRIFTLAB_ENABLED=1   # optional runtime governance tracing
